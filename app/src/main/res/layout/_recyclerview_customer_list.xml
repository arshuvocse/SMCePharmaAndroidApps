<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clickID"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:background="@color/white"
    android:clickable="true"
    android:elevation="10dp"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical">


    <LinearLayout
        android:id="@+id/dashboard_topbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <de.hdodenhof.circleimageview.CircleImageView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/profile_image"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_shopping_cart"
            android:transitionName="imagetrans"
            app:civ_border_color="@color/main"
            app:civ_border_width="2dp"

            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingBottom="8dp"

            >

            <TextView
                android:id="@+id/customerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/deepBlue"
                android:fontFamily="@font/lato_bold"
                android:textSize="20sp"
                android:transitionName="titletrans" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tag_code"
                    android:textColor="@color/deepBlue"
                    android:fontFamily="@font/lato_bold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/customer_code_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/black"
                    android:textSize="13sp"


                    />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tag_adress"
                    android:textColor="@color/deepBlue"
                    android:fontFamily="@font/lato_bold"
                    android:textSize="13sp"


                    />

                <TextView
                    android:id="@+id/customer_adress_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/black"
                    android:textSize="13sp"

                    />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tag_market"
                    android:textColor="@color/deepBlue"
                    android:fontFamily="@font/lato_bold"
                    android:textSize="13sp"

                    />

                <TextView
                    android:id="@+id/customer_market_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/black"
                    android:textSize="13sp" />


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tag_market_code"
                    android:textColor="@color/deepBlue"
                    android:fontFamily="@font/lato_bold"
                    android:textSize="13sp"

                    />

                <TextView
                    android:id="@+id/customer_marketcode_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/black"
                    android:textSize="13sp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/custtypelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tag_chemist_type"
                    android:textColor="@color/deepBlue"
                    android:fontFamily="@font/lato_bold"
                    android:textSize="13sp"

                    />

                <TextView
                    android:id="@+id/customer_type_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/black"
                    android:textSize="13sp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llmobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mobile"
                    android:textColor="@color/deepBlue"
                    android:fontFamily="@font/lato_bold"
                    android:textSize="13sp"

                    />

                <TextView
                    android:id="@+id/mobile_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/main"
                    android:textSize="13sp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llinvoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/invoice"
                    android:textColor="@color/deepBlue"
                    android:fontFamily="@font/lato_bold"
                    android:textSize="13sp"

                    />

                <TextView
                    android:id="@+id/invoice_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/deepBlue"
                    android:textSize="13sp" />


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"  android:visibility="gone" android:id="@+id/llbspcode"
                android:padding="5dp"
                android:layout_height="wrap_content" android:gravity="center" android:layout_gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtBspCode" android:layout_gravity="center" android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:padding="6dp"
                    android:text="BSP000123"
                    android:textColor="@color/deepBlue"
                    android:textSize="14sp"
                    android:background="#E3F2FD" /> <!-- Light Blue BG -->
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tag_sub_group"
                    android:textSize="13sp"

                    />

                <TextView
                    android:id="@+id/customer_subgroup_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/textGrey"
                    android:textSize="13sp" />


            </LinearLayout>


        </LinearLayout>


    </LinearLayout>


</LinearLayout>