<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/masterLayout"
    android:weightSum="6.5"
    android:orientation="horizontal"
    >

        <TextView
            android:id="@+id/dateTxt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".5"
            android:gravity="center"
            android:background="@drawable/border_around"
            android:padding="3dp"
            android:textSize="12sp"
            android:textColor="@color/black"
            />
        <TextView
            android:id="@+id/nameTxt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/border_around"
            android:padding="3dp"
            android:textSize="12sp"
            android:textColor="@color/black"
            />
        <TextView
            android:id="@+id/transportTxt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/border_around"
            android:padding="3dp"
            android:textSize="12sp"
            android:textColor="@color/black"
            />
        <TextView
            android:id="@+id/mileageTxt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/border_around"
            android:padding="3dp"
            android:textSize="12sp"
            android:textColor="@color/black"/>
        <TextView
            android:id="@+id/meterReadingId"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/black"
            android:background="@drawable/border_around"
            android:padding="3sp"
            android:textSize="12sp"
            />
        <TextView
            android:id="@+id/submarketTxt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/border_around"
            android:padding="3dp"
            android:textSize="12sp"
            android:textColor="@color/black"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/border_around"
            android:layout_weight="1">
                <TextView
                    android:id="@+id/statusTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="3dp"
                    android:textSize="12sp"
                    />

                <TextView
                    android:id="@+id/tv_approve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:visibility="gone"
                    android:background="@drawable/shape_approved"
                    android:fontFamily="@font/lato_bold"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="Approve"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
        </LinearLayout>


</LinearLayout>