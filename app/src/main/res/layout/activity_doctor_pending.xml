<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/masterLayout"
    android:background="@color/shadow_gen"
    tools:context=".Activity.Doctor.Pending.DoctorPendingActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/main">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar_custom"
                android:layout_width="0dp"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/main"
                android:layout_weight="1"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:theme="@style/ToolbarTheme"
                >

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >

                    <TextView
                        android:id="@+id/toolbar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/lato_bold"
                        android:text="Doctor List"
                        android:textColor="@color/white"
                        android:textSize="20sp" />


                </RelativeLayout>

            </androidx.appcompat.widget.Toolbar>
            <ImageView
                android:id="@+id/refresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground"
                android:layout_gravity="center"
                android:src="@drawable/ic_refresh"/>
            <ImageView
                android:id="@+id/filter"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground"
                android:layout_marginEnd="4dp"
                android:padding="2dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_filter_white"/>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/divcount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/dashboard_topbar"
            android:background="@color/main"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="@string/tag_count"
                android:textColor="@color/white"
                android:fontFamily="@font/lato_bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_bold"
                android:text="@string/_0"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipdoc"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_doctorpending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="vertical"
                    android:clipToPadding="false"
                    android:paddingBottom="20dp"

                    />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


        </LinearLayout>
        <!--  <androidx.cardview.widget.CardView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginStart="5dp"
              android:layout_marginEnd="5dp"
              app:cardElevation="5dp">

          </androidx.cardview.widget.CardView>-->
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>