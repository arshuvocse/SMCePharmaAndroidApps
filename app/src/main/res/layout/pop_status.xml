<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="match_parent"
    android:padding="4dp">
    <RadioGroup
        android:id="@+id/rg_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RadioButton
            android:id="@+id/rb_pending"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:buttonTint="@color/main"
            android:text="Pending" />

        <RadioButton
            android:id="@+id/rb_verified"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:buttonTint="@color/main"
            android:text="Verified" />

        <RadioButton
            android:id="@+id/rb_approved"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:buttonTint="@color/main"
            android:text="Approved" />

        <RadioButton
            android:id="@+id/rb_rejected"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:buttonTint="@color/main"
            android:text="Rejected" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rg_status">

        <TextView
            android:id="@+id/btn_cancelPop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@color/red"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/lato"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/common_cancel"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/btn_donePop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@color/main"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/lato"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/common_done"
            android:textColor="@color/white" />
    </LinearLayout>
