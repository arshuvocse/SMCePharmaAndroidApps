                </LinearLayout>

                <LinearLayout
                    android:elevation="5dp"
                    android:background="@drawable/endplace_shape"
                    android:layout_marginRight="10dp"
                    android:padding="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_weight="1.4"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="@string/EndPlace"
                            android:textColor="@color/main"
                            android:textSize="12sp" />


                        <Spinner
                            android:id="@+id/marketEndSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:elevation="10sp"

                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_weight="0.6"
                        android:layout_width="0dp"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_height="wrap_content">


                        <TextView
                            android:id="@+id/et_end_time"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:layout_margin="2dp"

                            android:background="@drawable/shape_recbg"
                            android:hint="Time"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>
                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/rl_other_market_visit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cell_shape"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="8dp"

                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="5sp">

                    <TextView
                        android:id="@+id/other_market_Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="@string/Other_Market_Visit"
                        android:textColor="@color/main"

                        />

                    <ImageView
                        android:id="@+id/otherMarketAdd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_baseline_add_24" />

                    <ListView
                        android:id="@+id/othermarketListLv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/otherMarketAdd"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="10dp"
                        android:scrollbars="none" />
                </RelativeLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/cell_shape"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"

                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tour_plan_purpose"
                        android:textColor="@color/main"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/tourPlanPurposeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:elevation="10sp" />

                </LinearLayout>
  <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
      android:id="@+id/llObjective"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/cell_shape"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"

                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/objective_purpose"
                        android:textColor="@color/main"
                        android:textSize="12sp" />



<!--      <EditText-->
<!--          android:hint="Objective 25 characters"-->
<!--          android:id="@+id/ObjectiveTxt"-->
<!--          android:maxLength="25"-->
<!--          android:layout_width="match_parent"-->
<!--          android:layout_height="wrap_content" />-->

      <EditText
          android:id="@+id/ObjectiveTxt"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="text"
          android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789,.!@#$%^*()_+-?/|:"
          android:hint="Enter Objective (English only)" />


                </LinearLayout>


                <LinearLayout
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <CheckBox
                            android:id="@+id/cb_start"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Is Starting Place"
                            android:buttonTint="@color/main"/>

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <CheckBox
                            android:id="@+id/cb_end"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Is Ending Place"
                            android:buttonTint="@color/main"/>



                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>



        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:id="@+id/ll_other"
            android:background="@color/white"
            android:elevation="5dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:layout_marginEnd="10dp"
            android:paddingBottom="5dp"
            tools:ignore="RtlSymmetry">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/cell_shape"
                android:elevation="5dp"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"

                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tour_plan_purpose_other"
                    android:textColor="@color/main"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/tourPlanPurposeOtherSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:elevation="10sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/laybtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/closeBtn"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10sp"
            android:layout_marginRight="20dp"
            android:layout_weight="1"
            android:background="@color/red"
