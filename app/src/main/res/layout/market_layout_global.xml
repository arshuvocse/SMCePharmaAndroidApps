<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/marketStructure">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/main_shadow"
        android:elevation="3dp"
        android:orientation="vertical"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/divGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/cell_shape"
            android:backgroundTint="@color/white"
            android:elevation="5dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="@string/tag_group"
                android:fontFamily="@font/latoregular"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/groupSpinner"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:elevation="10sp"
                />


        </LinearLayout>
        <LinearLayout
            android:id="@+id/divRegion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/cell_shape"
            android:backgroundTint="@color/white"
            android:elevation="5dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            tools:ignore="RtlSymmetry">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="@string/tag_zone"
                android:fontFamily="@font/latoregular"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/regionSpinner"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:elevation="10sp"

                />


        </LinearLayout>
        <LinearLayout
            android:id="@+id/divArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/cell_shape"
            android:backgroundTint="@color/white"
            android:elevation="5dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="@string/tag_area"
                android:fontFamily="@font/latoregular"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/areaSpinner"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:elevation="10sp"

                />


        </LinearLayout>
        <LinearLayout
            android:id="@+id/divTeritorry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/cell_shape"
            android:backgroundTint="@color/white"
            android:elevation="5dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="@string/tag_territory"
                android:fontFamily="@font/latoregular"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/territorySpinner"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:elevation="10sp"

                />


        </LinearLayout>
        <LinearLayout
            android:id="@+id/divSteritory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/cell_shape"
            android:backgroundTint="@color/white"
            android:elevation="5dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/latoregular"
                android:text="@string/subterritory"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/sterritorySpinner"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:elevation="10sp"

                />


        </LinearLayout>
        <LinearLayout
            android:id="@+id/divMarket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/cell_shape"
            android:backgroundTint="@color/white"
            android:elevation="5dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:layout_marginBottom="10dp"
            android:paddingTop="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="@string/market"
                android:fontFamily="@font/latoregular"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/marketSpinner"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:elevation="10sp"

                />


        </LinearLayout>


    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>