<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f7f7f7"
    android:paddingBottom="20dp"
    >
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"

        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/isMarketWise"
            android:layout_alignParentTop="true"
            android:layout_alignParentLeft="true"
            android:text="Yes"
            android:visibility="invisible"
            />

        <ImageView
            android:id="@+id/closeBtn"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_close"
            android:paddingTop="5dp"
            android:paddingRight="5dp"
            />
    </RelativeLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/white"

            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                >
                <com.google.android.material.textview.MaterialTextView

                    android:id="@+id/marketWiseClick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Market Wise"
                    android:padding="10dp"
                    android:gravity="center"
                    android:background="@color/main"
                    android:layout_marginRight="10dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:textColor="@color/white"
                    />
                <com.google.android.material.textview.MaterialTextView

                    android:id="@+id/customerWiseClick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Customer Wise"
                    android:padding="10dp"
                    android:gravity="center"
                    android:background="@drawable/cell_shape"
                    android:layout_marginLeft="10dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:textColor="@color/black"
                    />

            </LinearLayout>



        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginLeft="5dp"
            >
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/typeTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:textColor="@color/typeGrey"
                    android:textSize="14dp"
                    android:text="Add Market Wise Tour Plan"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"

                    />

                <TextView
                    android:id="@+id/tourDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentTop="true"
                    android:text="April 21,2021"
                    android:padding="10dp"

                    />

            </RelativeLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cell_shape"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Territory"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:textColor="@color/typeGrey"
                    />
                <Spinner
                    android:id="@+id/territorySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:elevation="10sp"

                    />


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cell_shape"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"

                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Market"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:textColor="@color/typeGrey"
                    />


                <Spinner
                    android:id="@+id/marketSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:elevation="10sp"

                    />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/customerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cell_shape"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:visibility="gone"

                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:textColor="@color/typeGrey"
                    />

                <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                    android:id="@+id/customerSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:elevation="10sp"

                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cell_shape"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:visibility="gone"

                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sub Market"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:textColor="@color/typeGrey"
                    />
                <Spinner
                    android:id="@+id/subMarketSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:elevation="10sp"

                    />


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cell_shape"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"

                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shift"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:textColor="@color/typeGrey"
                    />
                <Spinner
                    android:id="@+id/shiftSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:elevation="10sp"

                    />


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cell_shape"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"

                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tour Plan Type"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:textColor="@color/typeGrey"
                    />
                <Spinner
                    android:id="@+id/tourPlanTypeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:elevation="10sp"

                    />


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cell_shape"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"

                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tour Plan Purpose"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:textColor="@color/typeGrey"
                    />
                <Spinner
                    android:id="@+id/tourPlanPurposeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:elevation="10sp"
                    />


            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/remarksT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Comment"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginRight="20dp"
                android:layout_marginLeft="20dp"
                >

                <EditText
                    android:id="@+id/remarksTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </com.google.android.material.textfield.TextInputLayout>
            <Button
                android:id="@+id/psubmitBnt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add"
                android:background="@color/main"
                android:textColor="@color/white"
                android:layout_marginTop="10sp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                />

        </LinearLayout>






    </LinearLayout>

</LinearLayout>