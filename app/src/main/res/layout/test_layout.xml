<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:measureAllChildren="false"
    android:scrollbars="none"
    android:paddingBottom="50sp"
    android:layout_alignParentTop="true"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"

        >

        <LinearLayout
            android:id="@+id/dashboard_topbar"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical"
            android:weightSum="2"
            android:padding="10sp"
            android:background="@color/white"
            android:elevation="10dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10sp"
                >
                <de.hdodenhof.circleimageview.CircleImageView
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/profile_image"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@mipmap/ic_userpic"
                    app:civ_border_width="2dp"
                    app:civ_border_color="#FF000000"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="10dp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/userName"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/main"
                        android:layout_marginTop="17sp"
                        android:fontFamily="@font/roboto"
                        />




                </LinearLayout>

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20sp"
                android:fillViewport="true"
                android:measureAllChildren="false"
                android:scrollbars="none" >


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="125dp"
                        android:layout_height="80dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10sp"
                        android:elevation="10sp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:background="#009688"

                        >

                        <TextView
                            android:id="@+id/punchInTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:textColor="@color/white"
                            />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/white"
                            android:layout_marginTop="2sp"
                            android:layout_marginBottom="2sp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Punched In Time"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textSize="12dp"
                            android:paddingLeft="5sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/roboto"
                            />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="125dp"
                        android:layout_height="80dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10sp"
                        android:elevation="10sp"
                        android:layout_marginLeft="10sp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:background="#2979FF"
                        >

                        <TextView
                            android:id="@+id/weeklySaleTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:textColor="@color/white"
                            />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/white"
                            android:layout_marginTop="2sp"
                            android:layout_marginBottom="2sp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weekly Sales Amount"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textSize="12dp"
                            android:textColor="@color/white"
                            />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="125dp"
                        android:layout_height="80dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10sp"
                        android:elevation="10sp"
                        android:layout_marginLeft="10sp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:background="#D500F9"
                        >

                        <TextView
                            android:id="@+id/monthlySaleTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:textColor="@color/white"
                            />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/white"
                            android:layout_marginTop="2sp"
                            android:layout_marginBottom="2sp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monthly Sales Amount"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textSize="12dp"
                            android:textColor="@color/white"
                            />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="130dp"
                        android:layout_height="80dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10sp"
                        android:elevation="10sp"
                        android:layout_marginLeft="10sp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:background="#4CAF50"
                        >

                        <TextView
                            android:id="@+id/orderSubmitedTodayTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:textColor="@color/white"
                            />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/white"
                            android:layout_marginBottom="2sp"
                            android:layout_marginTop="2sp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Order Submitted Today"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textSize="12dp"
                            android:textColor="@color/white"
                            />

                    </LinearLayout>
                </LinearLayout>




            </HorizontalScrollView>



        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/dashboard_topbar"
            android:orientation="vertical"
            android:paddingRight="10dp"
            android:paddingLeft="3dp"
            android:paddingBottom="10dp"
            android:paddingTop="20dp"

            android:background="#f5f5f5"
            android:layout_marginTop="-10dp"

            >


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Regular Operations"
                    android:layout_marginTop="10sp"
                    android:textSize="16sp"
                    android:paddingBottom="5sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false" android:orientation="horizontal"
                    android:weightSum="4"
                    android:layout_marginTop="7sp"
                    android:layout_marginBottom="7sp"
                    android:paddingBottom="10sp"
                    >


                    <LinearLayout
                        android:id="@+id/dashboard_attendance_card"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:background="@drawable/button_capsul_shape"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:layout_weight="1"
                        android:padding="5sp"
                        android:layout_marginLeft="10sp"
                        android:elevation="10dp"

                        >
                        <ImageView
                            android:layout_width="45dp"
                            android:layout_height="55dp"
                            android:src="@drawable/ic_attendance"
                            />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Attendance"
                            android:gravity="center"
                            android:textSize="10dp"
                            android:paddingLeft="5sp"
                            android:padding="5sp"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/black"
                            />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/dashboard_customer_card"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:elevation="2sp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:layout_weight="1"
                        android:padding="5sp"
                        android:layout_marginLeft="8sp"

                        >
                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_shopping_cart"
                            />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Place Order"

                            android:gravity="center"
                            android:textSize="10dp"
                            android:paddingLeft="5sp"
                            android:padding="5sp"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/black"
                            />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/dashboard_OrderRecords"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:elevation="2sp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:layout_weight="1"
                        android:padding="5sp"
                        android:layout_marginLeft="10sp"

                        >
                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_immigration"
                            />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Order Tracking"
                            android:gravity="center"
                            android:textSize="10dp"
                            android:paddingLeft="5sp"
                            android:paddingTop="5sp"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/black"
                            />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/clickProduct"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:elevation="2sp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:layout_weight="1"
                        android:padding="5sp"
                        android:layout_marginLeft="10sp"

                        >
                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_box"
                            />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Product"
                            android:gravity="center"
                            android:textSize="10dp"
                            android:paddingLeft="5sp"
                            android:padding="5sp"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/black"
                            />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/demoLayoutId"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Add Information"
                        android:layout_marginTop="10sp"
                        android:textSize="16sp"
                        android:paddingBottom="5sp"
                        />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#c0c0c0"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false" android:orientation="horizontal"
                        android:weightSum="4"
                        android:layout_marginTop="7sp"
                        android:layout_marginBottom="7sp"
                        android:paddingBottom="5sp"
                        >

                        <LinearLayout
                            android:id="@+id/addCustomer"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:background="@color/white"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2sp"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_weight="1"
                            android:padding="5sp"
                            android:layout_marginLeft="10sp"

                            >
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_customer"
                                />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Customer"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textSize="10dp"
                                android:paddingLeft="5sp"
                                android:padding="5sp"
                                />

                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/doctorAdd"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:background="@color/white"

                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2sp"

                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_weight="1"
                            android:padding="5sp"
                            android:layout_marginLeft="10sp"

                            >
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_doctor"
                                />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Doctor"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textSize="10dp"
                                android:paddingLeft="5sp"
                                android:padding="5sp"
                                />

                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/leaveAdd"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:background="@color/white"

                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2sp"

                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_weight="1"
                            android:padding="5sp"
                            android:layout_marginLeft="10sp"

                            >
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_board"
                                />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Leave Info"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textSize="10dp"
                                android:paddingLeft="5sp"
                                android:padding="5sp"
                                />

                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/clickTada"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:background="@color/white"

                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2sp"

                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_weight="1"
                            android:padding="5sp"
                            android:layout_marginLeft="7sp"
                            android:layout_marginRight="10sp"

                            >
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@mipmap/ic_money"
                                />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TA DA"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textSize="10dp"
                                android:paddingLeft="5sp"
                                android:padding="5sp"
                                />

                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false" android:orientation="horizontal"
                        android:weightSum="4"
                        android:layout_marginTop="2sp"
                        android:layout_marginBottom="7sp"
                        >

                        <LinearLayout
                            android:id="@+id/clickExpenseClaim"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:background="@color/white"

                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2sp"

                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_weight="1"
                            android:padding="5sp"
                            android:layout_marginLeft="10sp"

                            >
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@mipmap/ic_expense"
                                />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Expense Claim"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textSize="10dp"
                                android:paddingLeft="5sp"
                                android:padding="5sp"
                                />

                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/prescription"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:background="@color/white"

                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2sp"

                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_weight="1"
                            android:padding="5sp"
                            android:layout_marginLeft="10sp"
                            android:visibility="gone"

                            >
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_prescription"
                                />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Prescription"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textSize="10dp"
                                android:paddingLeft="5sp"
                                android:padding="5sp"
                                />

                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/clickDCR"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:background="@color/white"

                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2sp"

                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_weight="1"
                            android:padding="5sp"
                            android:layout_marginLeft="10sp"
                            android:visibility="gone"

                            >
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@mipmap/ic_achievement"
                                />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add DCR"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textSize="10dp"
                                android:paddingLeft="5sp"
                                android:padding="5sp"
                                />

                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/tourPlan"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:background="@color/white"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2sp"

                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_weight="1"
                            android:padding="5sp"
                            android:layout_marginLeft="10sp"

                            >
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_destination"
                                />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tour Plan"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textSize="10dp"
                                android:paddingLeft="5sp"
                                android:padding="5sp"
                                />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="View Information"
                        android:layout_marginTop="10sp"
                        android:textSize="16sp"
                        android:paddingBottom="5sp"
                        />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#c0c0c0"

                        />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false" android:orientation="horizontal"
                        android:weightSum="4"
                        android:layout_marginTop="7sp"
                        android:layout_marginBottom="7sp"

                        >

                        <LinearLayout
                            android:id="@+id/dashboard_customer_card2"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:background="@color/white"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2sp"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_weight="1"
                            android:padding="5sp"
                            android:layout_marginLeft="7sp"
                            android:layout_marginRight="10sp"

                            >
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_warning"
                                />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Notice"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textSize="10dp"
                                android:paddingLeft="5sp"
                                android:padding="5sp"
                                />

                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/clickCampaing"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:background="@color/white"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2sp"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_weight="1"
                            android:padding="5sp"
                            android:layout_marginLeft="10sp"

                            >
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_menu_report"
                                />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:padding="5sp"
                                android:paddingLeft="5sp"
                                android:text="Campaign"
                                android:textSize="10dp"
                                android:textStyle="bold" />

                        </LinearLayout>




                    </LinearLayout>

                </LinearLayout>





            </LinearLayout>

        </LinearLayout>



    </LinearLayout>
</ScrollView>


