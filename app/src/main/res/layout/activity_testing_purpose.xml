<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.TestingPurposeActivity"
    android:orientation="vertical"
    android:background="#f7f7f7f7"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:elevation="6dp"
            android:background="@color/white"
            android:weightSum="3"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:gravity="center_vertical"
                android:textSize="25dp"
                android:textColor="@color/main"
                android:textStyle="bold"
                android:paddingLeft="10dp"
                android:background="@drawable/border_right"
                />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_weight="2"
                android:gravity="center"
                >
                <de.hdodenhof.circleimageview.CircleImageView
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/profile_image"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@mipmap/ic_userpic"
                    app:civ_border_width="2dp"
                    app:civ_border_color="#FF000000"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="10dp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/userName"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:text="Mohammad Shariful Islam SHaon"
                        />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Code :"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="sm908261"
                            android:layout_marginLeft="5dp"

                            />

                    </LinearLayout>




                </LinearLayout>

            </LinearLayout>


        </LinearLayout>
        <ScrollView
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:measureAllChildren="false"
            android:scrollbars="none"
            android:paddingBottom="50sp"
            android:layout_alignParentTop="true"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <HorizontalScrollView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20sp"
                    android:fillViewport="true"
                    android:measureAllChildren="false"
                    android:scrollbars="none" >


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="3dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        >

                        <LinearLayout
                            android:layout_width="130dp"
                            android:layout_height="80dp"
                            android:orientation="vertical"
                            android:elevation="10sp"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:background="#0097A7"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Punched In Time"
                                android:textStyle="bold"
                                android:textSize="12dp"
                                android:textColor="@color/white"
                                android:layout_marginTop="15dp"
                                android:layout_marginLeft="10dp"
                                />

                            <TextView
                                android:id="@+id/punchInTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/lightGrey"
                                android:text="No Records"
                                android:layout_marginTop="5dp"
                                android:layout_marginLeft="10dp"
                                />


                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="130dp"
                            android:layout_height="80dp"
                            android:layout_marginLeft="10sp"
                            android:background="#2979FF"
                            android:clickable="true"
                            android:elevation="10sp"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_marginTop="15dp"
                                android:text="Weekly Sales Amount"
                                android:textColor="@color/white"
                                android:textSize="12dp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/weeklySaleTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_marginTop="5dp"
                                android:text="No sale yet"
                                android:textColor="@color/lightGrey" />


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="130dp"
                            android:layout_height="80dp"
                            android:orientation="vertical"
                            android:elevation="10sp"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginLeft="10sp"
                            android:background="#059E53"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Monthly Sales Amount"
                                android:textStyle="bold"
                                android:textSize="12dp"
                                android:textColor="@color/white"
                                android:layout_marginTop="15dp"
                                android:layout_marginLeft="10dp"
                                />

                            <TextView
                                android:id="@+id/monthlySaleTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_marginLeft="10dp"
                                android:text="No sale yet"
                                android:textColor="@color/lightGrey"
                                />


                        </LinearLayout>



                    </LinearLayout>




                </HorizontalScrollView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    card_view:cardBackgroundColor="@android:color/white"
                    card_view:cardElevation="2dp"
                    android:layout_weight="2"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    >

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:gravity="center_vertical"

                        >
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Order Submitted Today"
                            android:gravity="center_vertical"
                            android:textColor="@color/black"
                            android:textSize="12dp"
                            android:paddingLeft="10dp"
                            />
                        <TextView
                            android:id="@+id/orderSubmitedTodayTxt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="50"
                            android:gravity="end"
                            android:textColor="@color/main"
                            android:textSize="18dp"
                            android:paddingRight="40dp"
                            android:textStyle="bold"
                            />


                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Regular Operations"
                        android:layout_marginTop="10sp"
                        android:textSize="16sp"
                        android:paddingBottom="5sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginLeft="5dp"
                        />






                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        >

                        <androidx.cardview.widget.CardView
                            android:id="@+id/dashboard_attendance_card"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            card_view:cardBackgroundColor="@android:color/white"
                            card_view:cardElevation="2dp"
                            card_view:cardUseCompatPadding="true"
                            android:layout_weight="2"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            app:cardCornerRadius="8dp"

                            >

                            <LinearLayout

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"

                                >
                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="45dp"
                                    android:src="@drawable/ic_attendance"
                                    />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Attendance"
                                    android:gravity="center"
                                    android:textSize="10dp"
                                    android:paddingLeft="5sp"
                                    android:padding="5sp"
                                    android:layout_marginTop="5dp"
                                    android:textColor="@color/black"
                                    />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/dashboard_customer_card"

                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            card_view:cardBackgroundColor="@android:color/white"
                            card_view:cardElevation="2dp"
                            card_view:cardUseCompatPadding="true"
                            android:layout_weight="2"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginLeft="10dp"
                            app:cardCornerRadius="8dp"
                            >

                            <LinearLayout

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"

                                >
                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="45dp"
                                    android:src="@drawable/ic_shopping_cart"
                                    />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Place Order"
                                    android:gravity="center"
                                    android:textSize="10dp"
                                    android:paddingLeft="5sp"
                                    android:padding="5sp"
                                    android:layout_marginTop="5dp"
                                    android:textColor="@color/black"
                                    />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>



                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        >

                        <androidx.cardview.widget.CardView
                            android:id="@+id/dashboard_OrderRecords"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            card_view:cardBackgroundColor="@android:color/white"
                            card_view:cardElevation="2dp"
                            card_view:cardUseCompatPadding="true"
                            android:layout_weight="2"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            app:cardCornerRadius="8dp"
                            >

                            <LinearLayout

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"

                                >
                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="45dp"
                                    android:src="@drawable/ic_immigration"
                                    />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Order Tracking"
                                    android:gravity="center"
                                    android:textSize="10dp"
                                    android:paddingLeft="5sp"
                                    android:padding="5sp"
                                    android:layout_marginTop="5dp"
                                    android:textColor="@color/black"
                                    />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/clickProduct"

                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            card_view:cardBackgroundColor="@android:color/white"
                            card_view:cardElevation="2dp"
                            card_view:cardUseCompatPadding="true"
                            android:layout_weight="2"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:layout_marginLeft="10dp"
                            app:cardCornerRadius="8dp"
                            >

                            <LinearLayout

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"

                                >
                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="45dp"
                                    android:src="@drawable/ic_box"
                                    />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Product"
                                    android:gravity="center"
                                    android:textSize="10dp"
                                    android:paddingLeft="5sp"
                                    android:padding="5sp"
                                    android:layout_marginTop="5dp"
                                    android:textColor="@color/black"
                                    />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>



                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/demoLayoutId"
                        >
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Add Information"
                            android:layout_marginTop="10sp"
                            android:textSize="16sp"
                            android:paddingBottom="5sp"
                            />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#c0c0c0"
                            />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false" android:orientation="horizontal"
                            android:weightSum="4"
                            android:layout_marginTop="7sp"
                            android:layout_marginBottom="7sp"
                            android:paddingBottom="5sp"
                            >

                            <LinearLayout
                                android:id="@+id/addCustomer"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:background="@color/white"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:elevation="2sp"
                                android:foreground="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:layout_weight="1"
                                android:padding="5sp"
                                android:layout_marginLeft="10sp"

                                >
                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:src="@drawable/ic_customer"
                                    />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Customer"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:textSize="10dp"
                                    android:paddingLeft="5sp"
                                    android:padding="5sp"
                                    />

                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/doctorAdd"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:background="@color/white"

                                android:orientation="vertical"
                                android:gravity="center"
                                android:elevation="2sp"

                                android:foreground="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:layout_weight="1"
                                android:padding="5sp"
                                android:layout_marginLeft="10sp"

                                >
                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:src="@drawable/ic_doctor"
                                    />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Doctor"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:textSize="10dp"
                                    android:paddingLeft="5sp"
                                    android:padding="5sp"
                                    />

                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/leaveAdd"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:background="@color/white"

                                android:orientation="vertical"
                                android:gravity="center"
                                android:elevation="2sp"

                                android:foreground="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:layout_weight="1"
                                android:padding="5sp"
                                android:layout_marginLeft="10sp"

                                >
                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:src="@drawable/ic_board"
                                    />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Leave Info"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:textSize="10dp"
                                    android:paddingLeft="5sp"
                                    android:padding="5sp"
                                    />

                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/clickTada"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:background="@color/white"

                                android:orientation="vertical"
                                android:gravity="center"
                                android:elevation="2sp"

                                android:foreground="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:layout_weight="1"
                                android:padding="5sp"
                                android:layout_marginLeft="7sp"
                                android:layout_marginRight="10sp"

                                >
                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:src="@mipmap/ic_money"
                                    />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TA DA"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:textSize="10dp"
                                    android:paddingLeft="5sp"
                                    android:padding="5sp"
                                    />

                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false" android:orientation="horizontal"
                            android:weightSum="4"
                            android:layout_marginTop="2sp"
                            android:layout_marginBottom="7sp"
                            >

                            <LinearLayout
                                android:id="@+id/clickExpenseClaim"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:background="@color/white"

                                android:orientation="vertical"
                                android:gravity="center"
                                android:elevation="2sp"

                                android:foreground="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:layout_weight="1"
                                android:padding="5sp"
                                android:layout_marginLeft="10sp"

                                >
                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:src="@mipmap/ic_expense"
                                    />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Expense Claim"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:textSize="10dp"
                                    android:paddingLeft="5sp"
                                    android:padding="5sp"
                                    />

                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/prescription"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:background="@color/white"

                                android:orientation="vertical"
                                android:gravity="center"
                                android:elevation="2sp"

                                android:foreground="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:layout_weight="1"
                                android:padding="5sp"
                                android:layout_marginLeft="10sp"
                                android:visibility="gone"

                                >
                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:src="@drawable/ic_prescription"
                                    />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Prescription"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:textSize="10dp"
                                    android:paddingLeft="5sp"
                                    android:padding="5sp"
                                    />

                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/clickDCR"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:background="@color/white"

                                android:orientation="vertical"
                                android:gravity="center"
                                android:elevation="2sp"

                                android:foreground="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:layout_weight="1"
                                android:padding="5sp"
                                android:layout_marginLeft="10sp"
                                android:visibility="gone"

                                >
                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:src="@mipmap/ic_achievement"
                                    />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Add DCR"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:textSize="10dp"
                                    android:paddingLeft="5sp"
                                    android:padding="5sp"
                                    />

                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/tourPlan"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:background="@color/white"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:elevation="2sp"

                                android:foreground="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:layout_weight="1"
                                android:padding="5sp"
                                android:layout_marginLeft="10sp"

                                >
                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:src="@drawable/ic_destination"
                                    />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tour Plan"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:textSize="10dp"
                                    android:paddingLeft="5sp"
                                    android:padding="5sp"
                                    />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="View Information"
                            android:layout_marginTop="10sp"
                            android:textSize="16sp"
                            android:paddingBottom="5sp"
                            />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#c0c0c0"

                            />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false" android:orientation="horizontal"
                            android:weightSum="4"
                            android:layout_marginTop="7sp"
                            android:layout_marginBottom="7sp"

                            >

                            <LinearLayout
                                android:id="@+id/dashboard_customer_card2"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:background="@color/white"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:elevation="2sp"
